APP_ENV=production
APP_NAME=CRM
APP_URL=https://ваш-проект.up.railway.app
API_URL=https://ваш-проект.up.railway.app
TIMEZONE=Europe/Minsk

SECRET_KEY=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_СЛУЧАЙНЫЙ_КЛЮЧ
SESSION_COOKIE_NAME=crm_session

# Supabase / другой managed Postgres (psycopg!)
DATABASE_URL=postgresql+psycopg://postgres:ПАРОЛЬ@db.xxxx.supabase.co:5432/postgres

STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/uploads

MAX_UPLOAD_MB=25
LOG_LEVEL=INFO

ADMIN_EMAIL=admin@kit-lab.by
ADMIN_PASSWORD=СМЕНИТЕ_ПАРОЛЬ_АДМИНА
LOGIN_RATE_LIMIT_ENABLED=true

# S3-совместимое хранилище (если файлы в облаке)
# STORAGE_BACKEND=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_USE_SSL=true
